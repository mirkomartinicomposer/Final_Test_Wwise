#############################
### GIT LFS: AUDIO FILES  ###
#############################

# Raw audio
*.wav filter=lfs diff=lfs merge=lfs -text
*.aiff filter=lfs diff=lfs merge=lfs -text
*.aif filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

#############################
### GIT LFS: WWEM/BNK      ###
#############################

*.wem filter=lfs diff=lfs merge=lfs -text
*.bnk filter=lfs diff=lfs merge=lfs -text
*.bnkinfo filter=lfs diff=lfs merge=lfs -text

# SoundBanks intere (se le committi)
GeneratedSoundBanks/** filter=lfs diff=lfs merge=lfs -text

#############################
### GIT LFS: Unreal Assets ###
#############################

*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text

#############################
### Text files remain text ###
#############################

*.ini text
*.txt text
*.json text
*.xml text
*.csv text
*.h text
*.cpp text
*.cs text
*.py text
*.md text
